[Unit]
Description=YOLOgate (AI vehicle counting)
After=network-online.target
Wants=network-online.target

[Service]
User=yologate
WorkingDirectory=/var/lib/yologate
Environment=VC_DATA_DIR=/var/lib/yologate/data
Environment=VC_MODEL=/var/lib/yologate/yolo11n.pt
Environment=YOLO_CONFIG_DIR=/var/lib/yologate/.ultralytics
Environment=PYTHONPATH=@DIR@
ExecStart=@DIR@/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
